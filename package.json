{
  "name": "forgelab",
  "version": "0.0.0",
  "private": true,
  "description": "ForgeLab — a browser-based 3D reactor and energy-system construction sandbox.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "pnpm --filter @forgelab/web dev",
    "build": "pnpm --filter @forgelab/web build",
    "preview": "pnpm --filter @forgelab/web preview",
    "typecheck": "tsc -p tsconfig.packages.json --noEmit && tsc -p apps/web/tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "vercel-build": "pnpm build && node scripts/build-vercel.mjs",
    "dev:api": "pnpm vercel-build && node scripts/serve-output.mjs 3000",
    "serve": "node scripts/serve-output.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@eslint/js": "^10.0.1",
    "@supabase/supabase-js": "^2.117.2",
    "@types/node": "^24.10.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "playwright": "1.56.1",
    "prettier": "^3.9.8",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  }
}
