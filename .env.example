# ForgeLab environment. Copy to apps/web/.env.local for `pnpm dev`, and set the same
# names in Vercel (Project → Settings → Environment Variables).
#
# Without any of these, ForgeLab builds and runs in local-only mode: the builder and
# simulation work fully and designs autosave in the browser; accounts, cloud saves,
# publishing and leaderboards are hidden.

# ---- Browser (public) -------------------------------------------------------------------
# Safe to expose: row-level security decides what these can do.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
# Optional: the site's canonical origin, used for auth redirects. Defaults to the page origin.
VITE_SITE_URL=https://forgelab.example.com
# Optional: the LiveKit server (voice). Only used at build time, for the CSP; clients get
# the URL with each voice token. Leave unset to build without voice.
# VITE_LIVEKIT_URL=wss://your-project.livekit.cloud

# ---- Server only (never prefix with VITE_) ---------------------------------------------
# Used only by /api/verify to recompute and record verified scores.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx
# Legacy alternative to SUPABASE_SECRET_KEY:
# SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ---- Communication endpoints (server only) ----------------------------------------------
# /api/comms/* and /api/voice/token query Postgres as the calling user with this key
# (falls back to VITE_SUPABASE_PUBLISHABLE_KEY).
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
# Signs presence tickets. Generate with: node scripts/generate-presence-key.mjs
# FORGELAB_PRESENCE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# Voice (LiveKit). The secret signs 5-minute, single-room tokens; it never reaches browsers.
# LIVEKIT_URL=https://your-project.livekit.cloud
# LIVEKIT_API_KEY=APIxxxxxxxxxxxx
# LIVEKIT_API_SECRET=replace-with-the-livekit-api-secret-at-least-32-chars
